{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ratebeer",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// Only served on the custom domain — no workers.dev / preview URLs.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "ratebeer.wberg.com",
			"custom_domain": true
		}
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/ws/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ratebeer",
			"database_id": "76a22f08-3b48-425a-8137-6bc967515867",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM",
				"class_name": "SessionRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"SessionRoom"
			]
		}
	]
	// Secrets (wrangler secret put): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
}